{
  "permissions": {
    "allow": [
      "Bash(./gradlew:*)",
      "Bash(cd backend:*)",
      "Bash(docker compose:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git tag:*)",
      "Bash(pnpm:*)",
      "Bash(k6 run:*)",
      "mcp__context7",
      "mcp__playwright"
    ],
    "ask": [
      "Bash(git push:*)"
    ],
    "deny": [
      "Bash(rm -rf:*)",
      "Read(.env)",
      "Read(.env.*)",
      "Read(**/.env)",
      "Read(**/.env.*)"
    ]
  },
  "enableAllProjectMcpServers": true
}
